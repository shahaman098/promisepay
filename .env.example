# PromisePay configuration — copy to .env and fill in.
# NEVER commit .env (organizers explicitly require env-only secrets).

# --- PayPal sandbox (required for live-sandbox mode) ---
# Create at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# webhook id from the developer dashboard (for signature verification in live mode)
PAYPAL_WEBHOOK_ID=

# --- PromisePay runtime ---
# offline: fixture payment records only (default; no PayPal account needed)
# sandbox: real PayPal sandbox API calls with provenance (retrieval time + links)
PROMISEPAY_MODE=offline
PORT=8787
# Shared secret for merchant/event APIs; webhooks use PayPal signature verification instead
PROMISEPAY_API_KEY=dev-key-change-me

# --- AI (optional; deterministic parser fallback always available) ---
# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PROMISEPAY_MODEL=gpt-4o-mini
